.toc{display:flex;flex-wrap:wrap;gap:4px 12px;padding:10px 0 14px;border-bottom:1px solid var(--line);margin-bottom:10px;font-size:12.5px}
.toc a{color:var(--muted);text-decoration:none;font:12px var(--mono)}
.toc a:hover{color:var(--accent)}
/* mandoc output */
.head,.foot{display:flex;justify-content:space-between;color:var(--muted);font:12px var(--mono);gap:10px}
.foot{margin-top:40px;border-top:1px solid var(--line);padding-top:10px}
.head-vol{text-align:center}
.manual-text h1,.manual-text h2{font:600 14px var(--sans);letter-spacing:.06em;text-transform:uppercase;margin:28px 0 8px;color:var(--fg)}
.manual-text h3{font:600 14px var(--sans);margin:20px 0 6px}
.manual-text .permalink{color:inherit;text-decoration:none}
.manual-text p{margin:.6em 0}
.manual-text section>p,.manual-text section>dl,.manual-text section>div,.manual-text section>table,.manual-text section>pre,.manual-text section>ul,.manual-text section>ol{margin-left:2.2em}
code,.Li,.Pa,.Fl,.Cm,.Nm,.Fn,.Fd,.In,.Ev,.Er,.Dv,.Ic,.Va,.Ad,.Ms,.Sx{font-family:var(--mono);font-size:.92em}
.Nm,.Fl,.Cm,.Fn,.Ic{color:var(--code);font-weight:600}
var,.Ar,.Fa,.Ft,.Va{color:var(--var);font-style:italic;font-family:var(--mono);font-size:.92em}
.Xr{text-decoration:none;border-bottom:1px dotted var(--accent)}
.Xr:hover{border-bottom-style:solid}
dl.Bl-tag>dt,dl.Bl-hang>dt{margin-top:.7em;font-weight:500}
dl.Bl-tag>dd,dl.Bl-hang>dd{margin-left:2.2em}
.Bd-indent{margin-left:2.2em}
pre,.Bd.Li,.Bd-literal{font:13px/1.45 var(--mono);background:var(--panel);border:1px solid var(--line);border-radius:7px;padding:10px 12px;overflow:auto}
pre.plain{background:none;border:0;padding:0;white-space:pre-wrap}
table.Nm td{vertical-align:top;padding-right:.6em}
table.tbl{border-collapse:collapse}table.tbl td{padding:2px 10px 2px 0}
b{font-weight:600}
/* home */
.home h1{font:600 30px var(--mono);margin:6px 0 4px}
.home .lead{color:var(--muted);margin:0 0 24px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px}
.card{border:1px solid var(--line);border-radius:10px;padding:12px 14px;cursor:pointer;background:var(--panel)}
.card:hover{border-color:var(--accent)}
.card b{font:600 18px var(--mono)}
.card div{color:var(--muted);font-size:13px}
.kbd{font:11px var(--mono);border:1px solid var(--line);border-bottom-width:2px;border-radius:4px;padding:0 5px}
.manpath{color:var(--muted);font:12px var(--mono);margin-top:28px;line-height:1.8}
.loading{color:var(--muted);padding:40px 0}
.menu-btn{display:none}
@media (max-width:760px){
  #app{grid-template-columns:1fr}
  aside{position:fixed;inset:0 20% 0 0;z-index:5;transform:translateX(-100%);transition:transform .2s}
  body.nav aside{transform:none;box-shadow:0 0 40px rgba(0,0,0,.3)}
  .wrap{padding:16px 16px 60px}
  .menu-btn{display:inline-block}
  .manual-text section>*{margin-left:0!important}
}
</style>
</head>
<body>
<div id="app">
  <aside>
    <div class="brand"><a href="#/">browse-man</a><small id="total"></small></div>
    <div class="search"><input id="q" placeholder="Search names & descriptions…  ( / )" autocomplete="off" spellcheck="false"></div>
    <div class="modes">
      <button data-mode="name" class="on">Names</button>
      <button data-mode="full" title="Search the full text of every page (press Enter)">Full text</button>
    </div>
    <div class="chips" id="chips"></div>
    <div class="count" id="count"></div>
    <ul id="list"></ul>
  </aside>
  <main id="main"><div class="wrap" id="view"><div class="loading">Loading index…</div></div></main>
</div>
<script>
(() => {
const $ = s => document.querySelector(s);
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let DB, PAGES = [], byKey = new Map(), byName = new Map();
let mode = 'name', sec = '', results = [], shown = 0, cursor = -1, current = -1, grepTimer = null, grepCtl = null;
const PAGE_SIZE = 300;

function secGroup(s){ return /^[0-9]/.test(s) ? s[0] : s[0] === 'n' ? 'n' : s; }

async function boot(){
  DB = await (await fetch('/api/index')).json();
  PAGES = DB.pages.map((p, id) => ({id, name:p[0], sec:p[1], desc:p[2]||'', path:p[3], alias:p[4], lname:p[0].toLowerCase(), ldesc:(p[2]||'').toLowerCase()}));
  for (const p of PAGES){
    byKey.set(p.sec + '/' + p.name, p.id);
    const k = p.lname; if (!byName.has(k)) byName.set(k, []); byName.get(k).push(p.id);
  }
  $('#total').textContent = PAGES.length.toLocaleString() + ' pages';
  const groups = {};
  for (const [s, n] of Object.entries(DB.sections)) { const g = secGroup(s); groups[g] = (groups[g]||0) + n; }
  DB.groups = groups;
  const order = Object.keys(groups).sort((a,b) => (a==='n') - (b==='n') || a.localeCompare(b, undefined, {numeric:true}));
  $('#chips').innerHTML = '<button data-sec="" class="on">All</button>' + order.map(g => `<button data-sec="${esc(g)}" title="${esc(DB.sectionNames[g]||'')}">${esc(g)}</button>`).join('');
  DB.order = order;
  search();
  route();
}

function resolve(name, s){
  if (s && byKey.has(s + '/' + name)) return byKey.get(s + '/' + name);
  const ids = byName.get(name.toLowerCase()) || [];
  if (!ids.length) return -1;
  if (s) { const m = ids.find(i => PAGES[i].sec[0] === s[0]); if (m !== undefined) return m; }
  return ids[0];
}

/* ---------- name search ---------- */
function search(){
  const q = $('#q').value.trim().toLowerCase();
  if (mode === 'full') { scheduleGrep(); return; }
  let list = sec ? PAGES.filter(p => secGroup(p.sec) === sec) : PAGES;
  if (q) {
    const terms = q.split(/\s+/);
    const scored = [];
    for (const p of list){
      let score = 0, ok = true;
      for (const t of terms){
        let s = 0;
        if (p.lname === t) s = 100;
        else if (p.lname.startsWith(t)) s = 60 - Math.min(p.lname.length - t.length, 30) / 2;
        else if (p.lname.includes(t)) s = 30;
        else if (p.ldesc.includes(t)) s = p.ldesc.match(new RegExp('\\b' + t.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'))) ? 12 : 6;
        if (!s) { ok = false; break; }
        score += s;
      }
      if (ok) scored.push([score + (p.sec[0] === '1' ? 2 : p.sec[0] === '8' ? 1 : 0), p]);
    }
    scored.sort((a,b) => b[0]-a[0] || a[1].name.length - b[1].name.length || a[1].name.localeCompare(b[1].name));
    results = scored.map(x => ({p:x[1]}));
  } else {
    results = list.map(p => ({p})).sort((a,b) => a.p.lname.localeCompare(b.p.lname) || a.p.sec.localeCompare(b.p.sec));
  }
  $('#count').textContent = results.length.toLocaleString() + (q ? ' matches' : ' pages');
  shown = 0; cursor = -1; $('#list').innerHTML = ''; renderMore();
}

function hl(text, q){
  if (!q) return esc(text);
  const terms = q.split(/\s+/).filter(Boolean).map(t => t.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'));
  if (!terms.length) return esc(text);
  const re = new RegExp('(' + terms.join('|') + ')', 'ig');
  return esc(text).replace(re, '<mark>$1</mark>');
}

function renderMore(){
  const q = $('#q').value.trim();
  const ul = $('#list'); const old = ul.querySelector('.more'); if (old) old.remove();
  const frag = document.createDocumentFragment();
  const end = Math.min(results.length, shown + PAGE_SIZE);
  for (let i = shown; i < end; i++){
    const {p, snippet} = results[i];
    const li = document.createElement('li');
    li.dataset.id = p.id; li.dataset.i = i;
    if (p.id === current) li.classList.add('active');
    li.innerHTML = `<span class="n">${hl(p.name, mode==='name'?q:'')}</span><span class="s">(${esc(p.sec)})</span>` +
      `<div class="d">${p.alias ? '→ ' + esc(p.alias) + ' · ' : ''}${hl(p.desc || '', mode==='name'?q:'')}</div>` +
      (snippet ? `<div class="snip">${hl(snippet, q)}</div>` : '');
    frag.appendChild(li);
  }
  shown = end;
  if (shown < results.length){
    const li = document.createElement('li'); li.className = 'more';
    li.textContent = `Show more (${(results.length - shown).toLocaleString()} left)`;
    frag.appendChild(li);
  }
  ul.appendChild(frag);
}

/* ---------- full-text search ---------- */
function scheduleGrep(immediate){
  clearTimeout(grepTimer);
  const q = $('#q').value.trim();
  if (q.length < 2){ results = []; $('#list').innerHTML=''; $('#count').textContent = 'Type at least 2 characters, then Enter'; return; }
  $('#count').textContent = 'Press Enter to search full text…';
  if (immediate) grep(q);
}
async function grep(q){
  if (grepCtl) grepCtl.abort();
  grepCtl = new AbortController();
  $('#count').textContent = 'Searching every page for “' + q + '”…';
  try{
    const r = await (await fetch('/api/grep?q=' + encodeURIComponent(q) + (sec ? '&sec=' + encodeURIComponent(sec) : ''), {signal: grepCtl.signal})).json();
    results = r.hits.map(h => ({p: PAGES[h.id], snippet: h.snippet}));
    $('#count').textContent = `${results.length}${results.length >= 200 ? '+' : ''} pages contain “${q}” · ${r.ms} ms`;
    shown = 0; cursor = -1; $('#list').innerHTML = ''; renderMore();
  } catch(e){ if (e.name !== 'AbortError') $('#count').textContent = 'Search failed'; }
}

/* ---------- views ---------- */
function home(){
  current = -1; markActive();
  document.title = 'browse-man';
  const g = DB.groups;
  $('#view').innerHTML = `<div class="home">
    <div class="toolbar"><button class="menu-btn" data-act="menu">☰ Pages</button></div>
    <h1>man pages</h1>
    <p class="lead">${PAGES.length.toLocaleString()} manual pages indexed on this machine. Press <span class="kbd">/</span> to search, <span class="kbd">↑</span><span class="kbd">↓</span> to move, <span class="kbd">Enter</span> to open.</p>
    <div class="grid">${DB.order.map(s => `<div class="card" data-sec="${esc(s)}"><b>${esc(s)}</b> <span style="color:var(--muted)">${(g[s]||0).toLocaleString()}</span><div>${esc(DB.sectionNames[s] || 'Section ' + s)}</div></div>`).join('')}
      <div class="card" data-act="random"><b>⚄</b><div>Random page</div></div></div>
    <div class="manpath">MANPATH<br>${DB.manpath.map(esc).join('<br>')}</div></div>`;
}

async function show(id, anchor){
  const p = PAGES[id]; current = id; markActive();
  document.title = `${p.name}(${p.sec}) — browse-man`;
  document.body.classList.remove('nav');
  $('#view').innerHTML = '<div class="loading">Rendering…</div>';
  const html = await (await fetch('/api/page?id=' + id)).text();
  if (current !== id) return;
  const others = (byName.get(p.lname) || []).filter(i => i !== id);
  $('#view').innerHTML = `<div class="toolbar">
      <button class="menu-btn" data-act="menu">☰ Pages</button>
      <code>man ${/^[0-9]/.test(p.sec) ? esc(p.sec[0]) + ' ' : ''}${esc(p.name)}</code>
      <button data-act="copy">Copy</button>
      <a href="/api/source?id=${id}" target="_blank">source</a>
      <span title="${esc(p.path)}">${esc(p.path)}</span>
      ${others.length ? '· also in ' + others.map(i => `<a href="#/${encodeURIComponent(PAGES[i].sec)}/${encodeURIComponent(PAGES[i].name)}">${esc(PAGES[i].sec)}</a>`).join(', ') : ''}
    </div><div class="toc" id="toc"></div><div id="doc">${html}</div>`;
  const heads = [...$('#doc').querySelectorAll('h1.Sh, h2.Sh')];
  $('#toc').innerHTML = heads.map(h => `<a data-anchor="${esc(h.id)}" href="#">${esc(h.textContent)}</a>`).join('');
  if (!heads.length) $('#toc').remove();
  $('#main').scrollTop = 0;
  if (anchor) { const el = document.getElementById(anchor); if (el) el.scrollIntoView(); }
}

function markActive(){
  for (const li of document.querySelectorAll('#list li.active')) li.classList.remove('active');
  const li = document.querySelector(`#list li[data-id="${current}"]`); if (li) li.classList.add('active');
}

function route(){
  const h = decodeURIComponent(location.hash.slice(1));
  const m = h.match(/^\/([^/]+)\/(.+)$/);
  if (!m) return home();
  const id = resolve(m[2], m[1]);
  if (id < 0) { $('#view').innerHTML = `<p class="loading">No page named <b>${esc(m[2])}(${esc(m[1])})</b> on this machine.</p>`; return; }
  const p = PAGES[id];
  if (p.sec !== m[1] || p.name !== m[2]) { history.replaceState(null, '', `#/${encodeURIComponent(p.sec)}/${encodeURIComponent(p.name)}`); }
  show(id);
}
function go(id){ const p = PAGES[id]; location.hash = `/${encodeURIComponent(p.sec)}/${encodeURIComponent(p.name)}`; }

/* ---------- events ---------- */
window.addEventListener('hashchange', route);
$('#q').addEventListener('input', () => { if (mode === 'name') search(); else scheduleGrep(); });
$('#q').addEventListener('keydown', e => {
  const lis = [...document.querySelectorAll('#list li[data-id]')];
  if (e.key === 'ArrowDown' || e.key === 'ArrowUp'){
    e.preventDefault();
    cursor = Math.max(0, Math.min(lis.length - 1, cursor + (e.key === 'ArrowDown' ? 1 : -1)));
    lis.forEach((li, i) => li.classList.toggle('active', i === cursor));
    if (lis[cursor]) lis[cursor].scrollIntoView({block:'nearest'});
  } else if (e.key === 'Enter'){
    if (mode === 'full' && cursor < 0) return scheduleGrep(true);
    const li = lis[cursor >= 0 ? cursor : 0]; if (li) go(+li.dataset.id);
  } else if (e.key === 'Escape'){ $('#q').value = ''; search(); $('#q').blur(); }
});
document.addEventListener('keydown', e => {
  if (e.key === '/' && document.activeElement !== $('#q')) { e.preventDefault(); $('#q').focus(); $('#q').select(); }
});
$('#list').addEventListener('click', e => {
  const li = e.target.closest('li'); if (!li) return;
  if (li.classList.contains('more')) return renderMore();
  go(+li.dataset.id);
});
document.querySelector('.modes').addEventListener('click', e => {
  const b = e.target.closest('button'); if (!b) return;
  mode = b.dataset.mode;
  document.querySelectorAll('.modes button').forEach(x => x.classList.toggle('on', x === b));
  $('#q').placeholder = mode === 'name' ? 'Search names & descriptions…  ( / )' : 'Search inside every page, then Enter';
  $('#q').focus(); search();
});
function setSec(s){
  sec = s;
  document.querySelectorAll('#chips button').forEach(x => x.classList.toggle('on', x.dataset.sec === s));
  if (mode === 'full' && $('#q').value.trim().length >= 2) scheduleGrep(true); else search();
}
$('#chips').addEventListener('click', e => { const b = e.target.closest('button'); if (b) setSec(b.dataset.sec); });
$('#view').addEventListener('click', e => {
  const card = e.target.closest('.card');
  if (card){ if (card.dataset.act === 'random') return go(Math.floor(Math.random() * PAGES.length)); setSec(card.dataset.sec); document.body.classList.add('nav'); return; }
  const act = e.target.closest('[data-act]');
  if (act && act.dataset.act === 'copy'){ navigator.clipboard.writeText(act.previousElementSibling.textContent); act.textContent = 'Copied'; setTimeout(() => act.textContent = 'Copy', 1200); return; }
  if (act && act.dataset.act === 'menu'){ document.body.classList.toggle('nav'); return; }
  const a = e.target.closest('a'); if (!a) return;
  const anchor = a.dataset.anchor || ((a.getAttribute('href')||'').match(/^#(?!\/)(.+)/)||[])[1];
  if (anchor){ e.preventDefault(); const el = document.getElementById(decodeURIComponent(anchor)); if (el) el.scrollIntoView({behavior:'smooth'}); }
});
$('#main').addEventListener('click', e => { if (document.body.classList.contains('nav') && !e.target.closest('[data-act="menu"]') && !e.target.closest('.card')) document.body.classList.remove('nav'); });

boot();
})();
</script>
</body>
</html>
"""

if __name__ == "__main__":
    main()
