#!/usr/bin/env python3
"""
browse-man — index and explore every man page on your machine in a web browser.

Zero dependencies: uses only the Python standard library and the system's
`mandoc` (shipped with macOS 13+) to render pages to HTML. Falls back to
`man` + `col` plain-text rendering if mandoc is not available.

Usage:
    browse-man                 # index all pages, start server, open browser
    browse-man ls              # open straight to ls(1)
    browse-man --port 9000 --no-open
    browse-man --rebuild       # ignore the cached index
"""

import argparse
import gzip
import html
import json
import os
import re
import shutil
import subprocess
import sys
import threading
import time
import webbrowser
from concurrent.futures import ThreadPoolExecutor
from functools import lru_cache
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, quote, urlparse

__version__ = "0.1.0"

CACHE_DIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/Library/Caches"),
    "browse-man",
)
CACHE_FILE = os.path.join(CACHE_DIR, "index-v1.json")

SECTION_NAMES = {
    "1": "General commands",
    "2": "System calls",
    "3": "Library functions",
    "4": "Devices & drivers",
    "5": "File formats",
    "6": "Games",
    "7": "Miscellaneous",
    "8": "System administration",
    "9": "Kernel internals",
    "n": "Tcl / Tk",
}

PAGE_RE = re.compile(r"^(?P<name>.+)\.(?P<sec>[0-9n][A-Za-z0-9_+-]*)$")


def log(*a):
    print("[browse-man]", *a, file=sys.stderr, flush=True)


# --------------------------------------------------------------------------
# Discovery
# --------------------------------------------------------------------------

def system_manpath():
    """Default search path as man(1) would compute it, ignoring $MANPATH."""
    env = {k: v for k, v in os.environ.items() if k != "MANPATH"}
    for cmd in (["manpath"], ["man", "-w"]):
        try:
            out = subprocess.run(cmd, capture_output=True, text=True,
                                 timeout=10, env=env).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            continue
        if out:
            return out
    return "/usr/share/man:/usr/local/share/man:/opt/homebrew/share/man"


def get_manpath(override=None):
    raw = override or os.environ.get("MANPATH") or ""
    if not raw:
        raw = system_manpath()
    elif raw.startswith(":") or raw.endswith(":") or "::" in raw:
        # An empty entry in MANPATH means "insert the system default here".
        default = system_manpath()
        raw = ":".join(default if not d else d for d in raw.split(":"))
    seen, out = set(), []
    for d in raw.split(":"):
        d = d.strip()
        if not d or not os.path.isdir(d):
            continue
        real = os.path.realpath(d)
        if real in seen:
            continue
        seen.add(real)
        out.append(d)
    return out


def scan_manpath(dirs):
    """Yield (name, section, path, root) for every page, in manpath order."""
    for root in dirs:
        try:
            subdirs = sorted(os.listdir(root))
        except OSError:
            continue
        for sub in subdirs:
            if not sub.startswith("man") or len(sub) < 4:
                continue
            secdir = os.path.join(root, sub)
            if not os.path.isdir(secdir):
                continue
            try:
                files = os.listdir(secdir)
            except OSError:
                continue
            for fn in files:
                base = fn[:-3] if fn.endswith(".gz") else fn
                m = PAGE_RE.match(base)
                if not m:
                    continue
                path = os.path.join(secdir, fn)
                if not os.path.isfile(path):  # also drops broken symlinks
                    continue
                yield m.group("name"), m.group("sec"), path, root


# --------------------------------------------------------------------------
# Reading / parsing roff sources
# --------------------------------------------------------------------------

def read_source(path, limit=None):
    try:
        if path.endswith(".gz"):
            with gzip.open(path, "rb") as f:
                data = f.read(limit) if limit else f.read()
        else:
            with open(path, "rb") as f:
                data = f.read(limit) if limit else f.read()
    except (OSError, EOFError):
        return ""
    return data.decode("utf-8", errors="replace")


ROFF_SUBS = [
    (re.compile(r"\\f(\[[^\]]*\]|\(..|.)"), ""),
    (re.compile(r"\\s[+-]?\d+"), ""),
    (re.compile(r"\\\*(\[[^\]]*\]|\(..|.)"), ""),
    (re.compile(r"\\\((em|en)"), "\u2014"),
    (re.compile(r"\\\((lq|rq|dq)"), '"'),
    (re.compile(r"\\\((oq|cq|aq)"), "'"),
    (re.compile(r"\\\(.."), ""),
    (re.compile(r"\\\[[^\]]*\]"), ""),
    (re.compile(r"\\[-]"), "-"),
    (re.compile(r"\\e"), "\\\\"),
    (re.compile(r"\\[&|^%:c]"), ""),
    (re.compile(r"\\[ ~0]"), " "),
    (re.compile(r"\\(.)"), r"\1"),
]


def strip_roff(s):
    for rx, rep in ROFF_SUBS:
        s = rx.sub(rep, s)
    return re.sub(r"\s+", " ", s).strip()


def resolve_so(src, root):
    """Return path of `.so` target if the page is just a redirect."""
    for line in src.splitlines():
        line = line.strip()
        if not line or line.startswith('.\\"') or line.startswith("'\\\""):
            continue
        if line.startswith(".so "):
            target = line[4:].strip()
            for cand in (target, target + ".gz"):
                p = os.path.join(root, cand)
                if os.path.isfile(p):
                    return p
        return None
    return None


def extract_desc(path, root, depth=0):
    src = read_source(path, 24576)
    if not src:
        return ""
    if depth < 3:
        so = resolve_so(src, root)
        if so:
            return extract_desc(so, root, depth + 1)
    # mdoc(7)
    m = re.search(r"^\.Nd\s+(.*)$", src, re.M)
    if m:
        return strip_roff(m.group(1).strip('"'))[:200]
    # man(7): text following .SH NAME
    m = re.search(r'^\.S[Hh]\s+"?(NAME|Name|名前|NOM|NOMBRE)"?\s*$', src, re.M)
    if not m:
        return ""
    parts = []
    for line in src[m.end():].splitlines():
        s = line.strip()
        if not s or s.startswith('.\\"'):
            continue
        if re.match(r"^\.(S[HhSs]|TH)\b", s):
            break
        if s.startswith("."):
            mm = re.match(r"^\.[A-Za-z]+\s*(.*)$", s)
            s = mm.group(1) if mm else ""
            if not s:
                continue
        parts.append(s)
        if len(" ".join(parts)) > 400:
            break
    text = strip_roff(" ".join(parts).replace('"', ""))
    for sep in (" - ", " -- ", " \u2014 ", " \u2013 "):
        if sep in text:
            return text.split(sep, 1)[1].strip()[:200]
    return text[:200]


# --------------------------------------------------------------------------
# Index
# --------------------------------------------------------------------------

class Index:
    def __init__(self, dirs, rebuild=False):
        self.dirs = dirs
        self.pages = []   # list of dicts
        self.by_name = {}  # name -> [ids]
        self._build(rebuild)

    def _build(self, rebuild):
        t0 = time.time()
        cache = {}
        if not rebuild:
            try:
                with open(CACHE_FILE) as f:
                    cache = json.load(f).get("files", {})
            except (OSError, ValueError):
                cache = {}

        entries, seen = [], set()
        for name, sec, path, root in scan_manpath(self.dirs):
            key = (name, sec)
            if key in seen:
                continue  # earlier manpath entry wins, like man(1)
            seen.add(key)
            entries.append((name, sec, path, root))

        def describe(e):
            name, sec, path, root = e
            real = os.path.realpath(path)
            try:
                st = os.stat(real)
                stamp = "%d:%d" % (st.st_mtime, st.st_size)
            except OSError:
                stamp = ""
            c = cache.get(path)
            if c and c[0] == stamp:
                return stamp, c[1]
            return stamp, extract_desc(path, root)

        with ThreadPoolExecutor(max_workers=min(16, (os.cpu_count() or 4) * 2)) as ex:
            results = list(ex.map(describe, entries, chunksize=64))

        new_cache = {}
        for (name, sec, path, root), (stamp, desc) in zip(entries, results):
            real = os.path.realpath(path)
            alias = None
            if real != path and os.path.islink(path):
                tb = os.path.basename(real)
                tb = tb[:-3] if tb.endswith(".gz") else tb
                mm = PAGE_RE.match(tb)
                if mm and mm.group("name") != name:
                    alias = mm.group("name")
            pid = len(self.pages)
            self.pages.append({
                "id": pid, "name": name, "sec": sec, "desc": desc,
                "path": path, "real": real, "root": root, "alias": alias,
            })
            self.by_name.setdefault(name, []).append(pid)
            self.by_name.setdefault(name.lower(), [])
            if name.lower() != name:
                self.by_name[name.lower()].append(pid)
            new_cache[path] = [stamp, desc]

        try:
            os.makedirs(CACHE_DIR, exist_ok=True)
            tmp = CACHE_FILE + ".tmp"
            with open(tmp, "w") as f:
                json.dump({"version": 1, "files": new_cache}, f)
            os.replace(tmp, CACHE_FILE)
        except OSError as e:
            log("could not write cache:", e)

        log("indexed %d pages from %d directories in %.1fs"
            % (len(self.pages), len(self.dirs), time.time() - t0))

    def resolve(self, name, sec=None):
        ids = self.by_name.get(name) or self.by_name.get(name.lower()) or []
        if not ids:
            return None
        if sec:
            for i in ids:
                if self.pages[i]["sec"] == sec:
                    return i
            for i in ids:
                if self.pages[i]["sec"].startswith(sec[0]):
                    return i
        return ids[0]

    def client_json(self):
        secs = {}
        for p in self.pages:
            secs[p["sec"]] = secs.get(p["sec"], 0) + 1
        return json.dumps({
            "version": __version__,
            "manpath": self.dirs,
            "sections": secs,
            "sectionNames": SECTION_NAMES,
            "pages": [
                [p["name"], p["sec"], p["desc"], p["path"], p["alias"]]
                for p in self.pages
            ],
        }, separators=(",", ":"))


# --------------------------------------------------------------------------
# Rendering
# --------------------------------------------------------------------------

MANDOC = shutil.which("mandoc") or ("/usr/bin/mandoc" if os.path.exists("/usr/bin/mandoc") else None)

XREF_RE = re.compile(
    r"(?<![\w\"=#/.-])(<(b|i|code|var)[^>]*>)?([A-Za-z_][\w.:+\-]*)(</\2>)?"
    r"\(([0-9n][A-Za-z0-9]*)\)"
)
ANCHOR_SPLIT = re.compile(r"(<a\b[^>]*>.*?</a>)", re.S)


def link_xrefs(fragment, index):
    """Turn plain `name(sec)` references (common in man(7) pages) into links."""
    def repl(m):
        name, sec = m.group(3), m.group(5)
        pid = index.resolve(name, sec)
        if pid is None:
            return m.group(0)
        p = index.pages[pid]
        href = "#/%s/%s" % (quote(p["sec"]), quote(p["name"]))
        return '<a class="Xr" href="%s">%s</a>' % (href, m.group(0))

    # Leave mandoc's header/footer lines (e.g. "LS(1)") alone.
    # Different mandoc versions use <main>/<div> and <div>/<table> for these.
    a = fragment.find('class="manual-text"')
    a = fragment.rfind("<", 0, a) if a >= 0 else 0
    b = fragment.rfind('class="foot"')
    b = fragment.rfind("<", 0, b) if b >= 0 else len(fragment)
    head, body, tail = fragment[:a], fragment[a:b], fragment[b:]
    parts = ANCHOR_SPLIT.split(body)
    for i in range(0, len(parts), 2):
        parts[i] = XREF_RE.sub(repl, parts[i])
    return head + "".join(parts) + tail


def render_page(index, pid):
    return _render_cached(index, pid)


@lru_cache(maxsize=256)
def _render_cached(index, pid):
    p = index.pages[pid]
    out = None
    if MANDOC:
        try:
            r = subprocess.run(
                [MANDOC, "-T", "html", "-W", "stop", "-O", "fragment,man=#/%S/%N", p["path"]],
                cwd=p["root"], capture_output=True, timeout=20,
            )
            if r.stdout.strip():
                out = r.stdout.decode("utf-8", errors="replace")
        except (OSError, subprocess.SubprocessError):
            out = None
    if out is None:
        out = render_plain(p)
    return link_xrefs(out, index)


def render_plain(p):
    env = dict(os.environ, MANPAGER="cat", PAGER="cat", MANWIDTH="100", LANG="en_US.UTF-8")
    try:
        r = subprocess.run(["man", p["path"]], capture_output=True, env=env, timeout=20)
        txt = r.stdout.decode("utf-8", errors="replace")
        txt = re.sub(r".\x08", "", txt)  # strip overstrike bold/underline
    except (OSError, subprocess.SubprocessError):
        txt = ""
    if not txt.strip():
        txt = read_source(p["path"])
    return '<pre class="plain">%s</pre>' % html.escape(txt)


# --------------------------------------------------------------------------
# Full-text search
# --------------------------------------------------------------------------

def full_text_search(index, query, limit=200, sec=None):
    q = query.lower()
    if len(q) < 2:
        return []
    uniq = {}
    for p in index.pages:
        if sec and not p["sec"].startswith(sec):
            continue
        uniq.setdefault(p["real"], p["id"])
    targets = list(uniq.values())
    hits, lock, stop = [], threading.Lock(), threading.Event()

    def scan(pid):
        if stop.is_set():
            return
        p = index.pages[pid]
        src = read_source(p["path"])
        low = src.lower()
        pos = low.find(q)
        if pos < 0:
            return
        count = low.count(q)
        snippet, first = "", None
        while pos >= 0:  # prefer a match outside roff comments
            ls = src.rfind("\n", 0, pos) + 1
            le = src.find("\n", pos)
            line = src[ls:le if le >= 0 else None]
            if first is None:
                first = line
            if not line.lstrip().startswith(('.\\"', "'\\\"", '\\"')):
                snippet = line
                break
            pos = low.find(q, le if le >= 0 else len(low))
        snippet = strip_roff(re.sub(r"^\.[A-Za-z]+\s*", "", snippet or first or ""))
        name_bonus = 1000 if q in p["name"].lower() else 0
        with lock:
            hits.append((name_bonus + count, pid, snippet[:220]))
            if len(hits) >= limit * 4:
                stop.set()

    with ThreadPoolExecutor(max_workers=min(16, (os.cpu_count() or 4) * 2)) as ex:
        list(ex.map(scan, targets, chunksize=32))
    hits.sort(key=lambda h: -h[0])
    return [{"id": pid, "score": s, "snippet": snip} for s, pid, snip in hits[:limit]]


# --------------------------------------------------------------------------
# HTTP server
# --------------------------------------------------------------------------

class Handler(BaseHTTPRequestHandler):
    index = None
    index_json = b""
    server_version = "browse-man/" + __version__

    def log_message(self, fmt, *args):  # quiet
        pass

    def _send(self, code, body, ctype="text/html; charset=utf-8", cache=False):
        if isinstance(body, str):
            body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Cache-Control", "max-age=3600" if cache else "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        # Only answer requests addressed to localhost (DNS-rebinding guard).
        host = (self.headers.get("Host") or "").split(":")[0]
        if host not in ("127.0.0.1", "localhost"):
            return self._send(403, "forbidden", "text/plain")
        u = urlparse(self.path)
        qs = parse_qs(u.query)
        try:
            if u.path == "/":
                return self._send(200, APP_HTML)
            if u.path == "/api/index":
                return self._send(200, self.index_json, "application/json")
            if u.path == "/api/page":
                pid = int(qs.get("id", ["-1"])[0])
                if not 0 <= pid < len(self.index.pages):
                    return self._send(404, "not found", "text/plain")
                body = render_page(self.index, pid)
                return self._send(200, body, "text/html; charset=utf-8", cache=True)
            if u.path == "/api/source":
                pid = int(qs.get("id", ["-1"])[0])
                if not 0 <= pid < len(self.index.pages):
                    return self._send(404, "not found", "text/plain")
                return self._send(200, read_source(self.index.pages[pid]["path"]),
                                  "text/plain; charset=utf-8")
            if u.path == "/api/grep":
                q = qs.get("q", [""])[0]
                sec = qs.get("sec", [""])[0] or None
                t0 = time.time()
                res = full_text_search(self.index, q, sec=sec)
                return self._send(200, json.dumps(
                    {"query": q, "ms": int((time.time() - t0) * 1000), "hits": res}),
                    "application/json")
            if u.path == "/favicon.ico":
                return self._send(204, b"", "image/x-icon")
        except (BrokenPipeError, ConnectionResetError):
            return
        except ValueError:
            return self._send(400, "bad request", "text/plain")
        self._send(404, "not found", "text/plain")


def main():
    ap = argparse.ArgumentParser(
        prog="browse-man",
        description="Index and explore all man pages on this machine in your browser.")
    ap.add_argument("page", nargs="?", help="open directly to this page, e.g. ls or printf.3")
    ap.add_argument("-p", "--port", type=int, default=8642, help="port (default 8642, 0 = random)")
    ap.add_argument("--no-open", action="store_true", help="don't open a browser window")
    ap.add_argument("--rebuild", action="store_true", help="ignore the cached index")
    ap.add_argument("--manpath", help="colon-separated directories (default: output of `manpath`)")
    ap.add_argument("--version", action="version", version="%(prog)s " + __version__)
    args = ap.parse_args()

    dirs = get_manpath(args.manpath)
    if not dirs:
        sys.exit("browse-man: no man directories found")
    if not MANDOC:
        log("mandoc not found; falling back to plain-text rendering")

    log("indexing %d man directories…" % len(dirs))
    idx = Index(dirs, rebuild=args.rebuild)
    Handler.index = idx
    Handler.index_json = idx.client_json().encode("utf-8")

    try:
        srv = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    except OSError:
        log("port %d busy, picking a random one" % args.port)
        srv = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    srv.daemon_threads = True
    url = "http://127.0.0.1:%d/" % srv.server_address[1]

    if args.page:
        m = re.match(r"^(.+?)(?:\.([0-9n]\w*)|\(([0-9n]\w*)\))?$", args.page)
        name, sec = m.group(1), m.group(2) or m.group(3)
        pid = idx.resolve(name, sec)
        if pid is None:
            log("no page named %r; opening index" % args.page)
        else:
            p = idx.pages[pid]
            url += "#/%s/%s" % (quote(p["sec"]), quote(p["name"]))

    log("serving at", url, "(Ctrl-C to quit)")
    if not args.no_open:
        threading.Timer(0.3, lambda: webbrowser.open(url)).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print()
    finally:
        srv.server_close()


